<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TestLogin" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

        <item name="android:statusBarColor">@color/transparente</item>
        <item name="android:windowBackground">@color/Fundo</item>

    </style>

    <style name="textoSubLog">
        <item name="fontFamily">@font/comfortaa</item>
        <item name="android:textColor">@color/TextoAcent</item>
    </style>

    <!-- TEMA COMPLETO PARA O DATE PICKER SPINNER -->
    <style name="MySpinnerDatePicker" parent="@android:style/Theme.DeviceDefault.Light.Dialog">

        <!-- Fundo arredondado -->
        <item name="android:windowBackground">@drawable/cantos_redondos_borda3</item>

        <!-- Botões (OK / Cancelar) -->
        <item name="android:buttonStyle">@style/MyDialogButton</item>

        <!-- Painel dos botões transparente (remove bordas retas) -->
        <item name="android:buttonBarStyle">@style/MyButtonBar</item>

        <!-- Estilo interno do DatePicker -->
        <item name="android:datePickerStyle">@style/MySpinnerStyle</item>

    </style>


    <!-- Estilo interno do DatePicker (força SPINNER + texto preto) -->
    <style name="MySpinnerStyle" parent="@android:style/Widget.DeviceDefault.DatePicker">

        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>

        <!-- Texto preto -->
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>

        <!-- Fundo dentro do DatePicker -->
        <item name="android:background">@drawable/cantos_redondos_borda</item>


    </style>


    <!-- Botões OK / Cancelar pretos -->
    <style name="MyDialogButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@android:color/transparent</item>
    </style>


    <!-- Remove fundo quadrado atrás dos botões -->
    <style name="MyButtonBar">
        <item name="android:background">@android:color/transparent</item>
    </style>


    <style name="Theme.TestLogin" parent="Base.Theme.TestLogin" />

    <style name="textoBottomNavigateInativo" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">16dp</item>

    </style>

    <style name="textoBottomNavigateAtivo" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">24dp</item>
        <item name="android:textStyle">bold</item>

    </style>

    <style name="CustomTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">20sp</item>
        <item name="fontFamily">@font/league_spartan</item>
        <item name="textAllCaps">false</item>


    </style>
    <style name="cantoRedondo">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10%</item>
    </style>
    <style name="redondo">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="MyTabTextStyle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Theme.Transparent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
    </style>




</resources>