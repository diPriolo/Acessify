<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/a1"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/ripple_persobtn"
        android:paddingBottom="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/acessorio_1"
        app:layout_constraintEnd_toStartOf="@+id/a2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/Cinza" />

    <ImageView
        android:id="@+id/a2"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/ripple_persobtn"
        android:paddingBottom="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/acessorio_3"
        app:layout_constraintBottom_toBottomOf="@+id/a1"
        app:layout_constraintEnd_toStartOf="@+id/a3"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/a1"
        app:layout_constraintTop_toTopOf="@+id/a1"
        app:srcCompat="@drawable/acessorio_2"
        app:tint="@color/Cinza" />

    <ImageView
        android:id="@+id/a3"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/ripple_persobtn"
        android:paddingBottom="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/acessorio_3"
        app:layout_constraintBottom_toBottomOf="@+id/a1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/a2"
        app:layout_constraintTop_toTopOf="@+id/a1"
        app:tint="@color/Cinza" />

    <ImageView
        android:id="@+id/an"
        android:layout_width="180dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/ripple_persobtn"
        android:scaleType="fitCenter"
        android:src="@drawable/outline_cancel_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/a2"
        app:tint="@color/Cinza" />

</androidx.constraintlayout.widget.ConstraintLayout>