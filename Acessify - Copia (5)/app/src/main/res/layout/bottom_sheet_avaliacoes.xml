<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cima_arredondado"
    android:backgroundTint="@color/fundo2"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/drag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        app:srcCompat="@drawable/bottom_sheet_icon"
        app:tint="@color/Cinza" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/Fundo"
        android:orientation="vertical"
        android:paddingHorizontal="6dp">

        <ImageView
            android:id="@+id/btnVolta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/arrow_right"
            app:tint="@color/fundo_claro" />

        <TextView
            android:id="@+id/textView21"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/league_spartan"
            android:text="Avaliação:"
            android:textAlignment="center"
            android:textColor="@color/textoEscuro"
            android:textSize="28sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#EDE6FE"
            app:cardCornerRadius="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNomel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/league_spartan"
                    android:text="Nome Local"
                    android:textColor="@color/textoEscuro"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/suvnomel5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:fontFamily="@font/league_spartan"
                    android:text="Subnome local"
                    android:textColor="@color/TextoDarkAcent"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/imageView24"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="10dp"
                    app:srcCompat="@color/TextoDarkAcent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16sp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imageView21"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:shapeAppearance="@style/redondo"
                            app:srcCompat="@drawable/acessifylogomenu" />

                        <TextView
                            android:id="@+id/nomeu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/league_spartan"
                            android:text="NOME USUARIO"
                            android:textColor="@color/textoEscuro"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/notaavl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:fontFamily="@font/league_spartan"
                            android:text="nota avaliacao"
                            android:textColor="@color/VerdeDark"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/imageView22"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/pinverde" />

                        <TextView
                            android:id="@+id/textData"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/league_spartan"
                            android:text="TextView"
                            android:textAlignment="textEnd"
                            android:textColor="@color/Cinza"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txttexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        android:fontFamily="@font/comfortaa"
                        android:text="asjdakjsd ASajsdwhjda Adjaksdjw32ooisd ASdkasdjakj "
                        android:textColor="@color/Texto2"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recImg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="10dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageView23"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_coracao_vazio" />

                        <TextView
                            android:id="@+id/curtidas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/league_spartan"
                            android:text="13"
                            android:textColor="@color/Cinza"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/condicao2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/league_spartan"
                            android:text="nenhuma"
                            android:textAlignment="textEnd"
                            android:textColor="@color/Vermelho"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnDelete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="16dp"
                    android:backgroundTint="@color/Vermelho"
                    android:backgroundTintMode="add"
                    android:drawableLeft="@drawable/baseline_delete_24"
                    android:drawableTint="@color/Fundo"
                    android:elevation="4dp"
                    android:fontFamily="@font/league_spartan"
                    android:text="Apagar avaliação"
                    android:textColor="@color/Fundo"
                    android:textSize="18sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>