<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="false"
    android:outlineAmbientShadowColor="#000000"
    android:transitionName="shared_morph_element"
    tools:context=".MainActivity"

    >

    <ImageView
        android:id="@+id/wave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:scaleType="fitXY"
        android:transitionName="wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/waves_login" />

    <ImageView
        android:id="@+id/Logo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:transitionName="logo"
        app:layout_constraintBottom_toBottomOf="@+id/wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/wave"
        app:layout_constraintVertical_bias="0.26"
        app:srcCompat="@drawable/acessifylogomenu" />

    <ImageView
        android:id="@+id/Borda"
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:transitionName="borda"
        app:layout_constraintBottom_toBottomOf="@+id/Logo"
        app:layout_constraintEnd_toEndOf="@+id/Logo"
        app:layout_constraintStart_toStartOf="@+id/Logo"
        app:layout_constraintTop_toTopOf="@+id/Logo"
        app:srcCompat="@drawable/circulo" />

    <TextView
        android:id="@+id/EditNome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/league_spartan"
        android:gravity="center"

        android:text="Acessify"

        android:textAlignment="center"

        android:textColor="#FDF6FE"
        android:textSize="70sp"
        android:transitionName="nome"
        android:translationY="-34dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Borda" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/cadastro"
        android:layout_width="310dp"
        android:layout_height="65dp"
        android:background="@drawable/gradiente_botoes"
        android:fontFamily="@font/league_spartan"
        android:gravity="center_horizontal|center_vertical"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Cadastre-se"
        android:textAllCaps="false"
        android:textColor="#FDF6FE"
        android:textFontWeight="700"
        android:textSize="35sp"
        android:transitionName="cadastro"
        app:layout_constraintBottom_toTopOf="@+id/login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wave"
        app:layout_constraintVertical_chainStyle="spread" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/login"
        android:layout_width="310dp"
        android:layout_height="65dp"
        android:elevation="16dp"
        android:fontFamily="@font/league_spartan"
        android:gravity="center_horizontal|center_vertical"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="@color/Fundo"
        android:textFontWeight="700"
        android:textSize="35sp"
        android:transitionName="login"
        android:translationZ="8dp"
        app:backgroundTint="#CDC1FB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cadastro" />


</androidx.constraintlayout.widget.ConstraintLayout>