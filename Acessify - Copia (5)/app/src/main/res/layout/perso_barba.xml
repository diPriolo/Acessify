<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ba1"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="16dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_persobtn"
            android:paddingHorizontal="15dp"
            android:paddingBottom="90dp"
            android:scaleType="centerCrop"
            android:src="@drawable/barba_1"
            app:tint="@color/Cinza" />

        <ImageView
            android:id="@+id/ba2"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="16dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_persobtn"
            android:paddingHorizontal="-60dp"
            android:paddingBottom="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/barba_2"
            app:tint="@color/Cinza" />
    </LinearLayout>

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

        <ImageView
            android:id="@+id/ba3"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="16dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_persobtn"
            android:paddingHorizontal="-50dp"
            android:paddingBottom="190dp"
            android:scaleType="centerCrop"
            android:src="@drawable/barba_3"
            app:tint="@color/Cinza" />

        <ImageView
            android:id="@+id/ba4"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="16dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_persobtn"
            android:paddingHorizontal="-10dp"
            android:paddingBottom="120dp"
            android:scaleType="centerCrop"
            android:src="@drawable/barba_4"
            app:tint="@color/Cinza" />
</LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ba5"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="16dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_persobtn"
            android:paddingHorizontal="-30dp"
            android:paddingBottom="110dp"
            android:scaleType="centerCrop"
            android:src="@drawable/barba_5"
            app:tint="@color/Cinza" />

        <ImageView
            android:id="@+id/ban"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="16dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_persobtn"
            android:scaleType="fitCenter"
            android:src="@drawable/outline_cancel_24"
            app:tint="@color/Cinza" />
    </LinearLayout>

</LinearLayout>