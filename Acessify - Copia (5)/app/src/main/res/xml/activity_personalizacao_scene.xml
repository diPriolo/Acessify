<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetStart="@id/start"
        motion:constraintSetEnd="@id/end"
        motion:duration="550" motion:motionInterpolator="easeInOut"></Transition>

    <ConstraintSet android:id="@+id/start">

    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/textView35"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="@+id/textView34"
            motion:layout_constraintStart_toStartOf="parent"
            android:visibility="gone" />
        <Constraint
            android:id="@+id/textView34"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="@+id/textView27"
            motion:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
        <Constraint
            android:layout_height="wrap_content"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:id="@+id/textView27"
            android:layout_marginTop="10dp" />
        <Constraint
            android:id="@+id/Entrar"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="310dp"
            android:layout_height="65dp"
            motion:layout_constraintBottom_toTopOf="@+id/naoCriar"
            motion:layout_constraintTop_toBottomOf="@+id/textView35"
            motion:layout_constraintVertical_chainStyle="spread"
            motion:layout_constraintHorizontal_bias="0.5"
            motion:layout_constraintStart_toStartOf="parent"
            android:visibility="gone" />
        <Constraint
            android:layout_height="65dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintHorizontal_bias="0.5"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="310dp"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintVertical_chainStyle="packed"
            android:id="@+id/naoCriar"
            android:layout_marginBottom="16dp" >
            <CustomAttribute
                motion:attributeName="text"
                motion:customStringValue="Continuar" />
        </Constraint>
        <Constraint
            android:id="@+id/container_personalizacao"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="visible"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintBottom_toTopOf="@+id/naoCriar"
            android:layout_marginBottom="8dp" />
        <Constraint
            android:id="@+id/wave"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintHorizontal_bias="1.0"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            android:translationY="-100dp" />
    </ConstraintSet>
    <ConstraintSet android:id="@+id/mid">
        <Constraint
            android:layout_height="wrap_content"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:id="@+id/textView27"
            android:layout_marginTop="10dp" />
        <Constraint
            android:id="@+id/Entrar"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="310dp"
            android:layout_height="65dp"
            motion:layout_constraintBottom_toTopOf="@+id/naoCriar"
            motion:layout_constraintTop_toBottomOf="@+id/textView35"
            motion:layout_constraintVertical_chainStyle="spread"
            motion:layout_constraintHorizontal_bias="0.5"
            motion:layout_constraintStart_toStartOf="parent"
            android:visibility="gone"
            />
        <Constraint
            android:layout_height="65dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintHorizontal_bias="0.5"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="310dp"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintVertical_chainStyle="packed"
            android:id="@+id/naoCriar"
            android:layout_marginBottom="16dp" >
            <CustomAttribute
                motion:attributeName="text"
                motion:customStringValue="Continuar" />
        </Constraint>
        <Constraint
            android:id="@+id/container_personalizacao"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:translationY="1000dp"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintBottom_toTopOf="@+id/naoCriar" />
        <Constraint
            android:id="@+id/textView34"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="@+id/textView27"
            motion:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp">
            <CustomAttribute
                motion:attributeName="text"
                motion:customStringValue="Quase lá..." />
        </Constraint>
        <Constraint
            android:id="@+id/textView35"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="@+id/textView34"
            motion:layout_constraintStart_toStartOf="parent">
            <CustomAttribute
                motion:attributeName="text"
                motion:customStringValue="Agora só mais alguns detalhes" />
        </Constraint>
    </ConstraintSet>



</MotionScene>
