<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/b1"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/ripple_persobtn"
        android:paddingBottom="40dp"
        android:scaleType="centerCrop"
        android:src="@drawable/brinco_1"
        app:layout_constraintBottom_toTopOf="@+id/bn"
        app:layout_constraintEnd_toStartOf="@+id/b2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/Cinza" />

    <ImageView
        android:id="@+id/b2"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/ripple_persobtn"
        android:paddingBottom="40dp"
        android:scaleType="centerCrop"
        android:src="@drawable/brinco_2"
        app:layout_constraintBottom_toBottomOf="@+id/b1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/b1"
        app:layout_constraintTop_toTopOf="@+id/b1"
        app:tint="@color/Cinza" />

    <ImageView
        android:id="@+id/bn"
        android:layout_width="180dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/ripple_persobtn"
        android:scaleType="fitCenter"
        android:src="@drawable/outline_cancel_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/Cinza" />
</androidx.constraintlayout.widget.ConstraintLayout>