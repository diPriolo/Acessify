<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"


    android:background="@drawable/cima_arredondado"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView

            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <TextView
        android:id="@+id/tituloSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="-10dp"
        android:fontFamily="@font/league_spartan"
        android:text="Masp"
        android:textAllCaps="true"
        android:textColor="@color/Texto2"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/descSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/league_spartan"
        android:text="TextView"
        android:textColor="@color/TextoAcent"
        android:textSize="25sp"
        tools:text="Museu de Arte de São Paulo Assis Chateaubriand " />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="20dp"
        android:gravity="top|left"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notaSheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:text="5.0"
            android:textColor="@color/Cinza"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/nivel"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="10dp"
            app:srcCompat="@drawable/ic_launcher_background" />

        <TextView
            android:id="@+id/avaliacoesNumero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/comfortaa"
            android:text="(90)"
            android:textColor="@color/Cinza"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/icSalvar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="right"
            android:paddingLeft="-4dp"
            android:paddingRight="-4dp"
            app:srcCompat="@drawable/book_mark" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imageViewCapaSheet"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="10dp"
        android:scaleType="centerCrop"
        app:srcCompat="@color/AzulFundo" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#F7F7F7"
        app:tabIndicatorColor="#5E3EBB"
        app:tabTextAppearance="@style/CustomTabText"
        app:tabTextColor="@color/Texto2" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tab"
        android:layout_marginHorizontal="20dp" />


</LinearLayout>